rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /config/{docId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
      allow update: if isAdmin();

      // Mutual friendships. Only the owner can read their friends list;
      // both sides are written by the addFriend/removeFriend Cloud Functions.
      match /friends/{friendId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /wishlists/{wishlistId} {
        allow create: if request.auth != null
          && request.auth.uid == userId;

        allow read: if true;

        allow update, delete: if request.auth != null
          && request.auth.uid == userId;

        allow delete: if isAdmin();

        match /items/{itemId} {
          allow read, write: if request.auth != null
            && request.auth.uid == userId;

          allow read: if true;

          allow delete: if isAdmin();
        }

        match /reservations/{itemId} {
          allow read: if request.auth == null
            || request.auth.uid != userId;

          allow delete: if isAdmin();
        }
      }
    }

    match /usernames/{username} {
      // Single lookups only (public list pages, availability check).
      // Listing the whole directory is reserved for admins.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
